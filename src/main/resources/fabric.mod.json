{
  "schemaVersion": 1,
  "id": "trc-core",
  "version": "${version}",
  "name": "TRC Core & Libs",
  "description": "The central library, GUI, settings, and framework for TRC-AI mods.",
  "authors": [
    "TRC-AI"
  ],
	"contact": {
		"github": "https://github.com/TRC-AI/"
	},
	"license": "MIT",
