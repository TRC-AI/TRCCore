	"environment": "*",
    "entrypoints": {
      "main": [
        "trc.core.TRCCore"
      ],
      "client": [
        "trc.core.TRCCoreClient"
      ]
    },
	"mixins": [
      "trc-core.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ["26.2"],
		"java": ">=25",
		"fabric-api": ">=0.150.2"
